{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"assist": {
		"actions": {
			"source": {
				"preset": "all",
				"useSortedPackageJson": "off"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"**",
			"!!**/{dist,coverage,public,.wrangler,test-results,playwright-report,.lighthouseci}",
			"!**/src/routeTree.gen.ts",
			"!**/src/types/cloudflare-env.d.ts"
		]
	},
	"linter": {
		"rules": {
			"a11y": {
				"preset": "all"
			},
			"complexity": {
				"preset": "all"
			},
			"nursery": {
				"preset": "all"
			},
			"performance": {
				"preset": "all",
				"useSolidForComponent": "off"
			},
			"security": {
				"noSecrets": "off",
				"preset": "all"
			},
			"style": {
				"noJsxLiterals": "off",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/__mocks__/**", "**/__mocks__"],
								"message": "Do not import from __mocks__ files. Import the original module and let Vitest load its mock."
							}
						]
					}
				},
				"noTernary": "off",
				"preset": "all",
				"useExportsLast": "off"
			},
			"suspicious": {
				"noReactSpecificProps": "off",
				"preset": "all"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.config.*"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off",
						"noProcessEnv": "off",
						"useNamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["**/__mocks__/**", "src/routes/api/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off",
						"useNamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"linter": {
				"rules": {
					"style": {
						"noMagicNumbers": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/__mocks__/**", "**/__mocks__"],
										"message": "Do not import from __mocks__ files. Import the original module and let Vitest load its mock."
									},
									{
										"group": ["../**"],
										"message": "Use @/ imports instead of parent-directory imports so architecture boundaries are enforced."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"**/src/{assets,components,config,db,hooks,lib,stores,testing,types,utils}/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/__mocks__/**", "**/__mocks__"],
										"message": "Do not import from __mocks__ files. Import the original module and let Vitest load its mock."
									},
									{
										"group": ["../**"],
										"message": "Use @/ imports instead of parent-directory imports so architecture boundaries are enforced."
									},
									{
										"group": [
											"@/routes",
											"@/routes/**",
											"@/router",
											"@/router.*",
											"@/client",
											"@/client.*",
											"@/routeTree.gen",
											"@/routeTree.gen.*",
											"@/app",
											"@/app/**"
										],
										"message": "Shared modules and features must not import application composition. Compose features in src/routes."
									},
									{
										"group": ["@/features", "@/features/**"],
										"message": "Shared modules must not import features. Move reusable code into shared modules."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/__mocks__/**", "**/__mocks__"],
										"message": "Do not import from __mocks__ files. Import the original module and let Vitest load its mock."
									},
									{
										"group": ["../**"],
										"message": "Use @/ imports instead of parent-directory imports so architecture boundaries are enforced."
									},
									{
										"group": [
											"@/routes",
											"@/routes/**",
											"@/router",
											"@/router.*",
											"@/client",
											"@/client.*",
											"@/routeTree.gen",
											"@/routeTree.gen.*",
											"@/app",
											"@/app/**"
										],
										"message": "Shared modules and features must not import application composition. Compose features in src/routes."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"plugins": [
		{
			"includes": [
				"**/__tests__/*.spec.{ts,tsx}",
				"**/browser-tests/*.spec.ts"
			],
			"path": "./plugins/prefer-once-mocks.grit"
		},
		{
			"includes": ["**"],
			"path": "./plugins/no-inline-vitest-mock.grit"
		},
		{
			"includes": [
				"**/__tests__/*.spec.{ts,tsx}",
				"**/browser-tests/*.spec.ts"
			],
			"path": "./plugins/require-test-aaa.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./plugins/no-side-effects-in-wait-for.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./plugins/prefer-user-event.grit"
		}
	],
	"root": false,
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"root": ".",
		"useIgnoreFile": true
	}
}
