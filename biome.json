{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"assist": {
		"actions": {
			"source": {
				"preset": "all",
				"useSortedPackageJson": "off"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"**",
			"!!**/{dist,coverage,public,.wrangler,test-results,playwright-report,.lighthouseci,.agents}",
			"!**/src/routeTree.gen.ts",
			"!**/src/types/cloudflare-env.d.ts"
		]
	},
	"linter": {
		"rules": {
			"a11y": "error",
			"complexity": "error",
			"correctness": "error",
			"nursery": "error",
			"performance": "error",
			"security": "error",
			"style": "error",
			"suspicious": "error"
		}
	},
	"overrides": [
		{
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"nursery": {
						"noTailwindArbitraryValue": "off"
					}
				}
			}
		},
		{
			"includes": ["src/styles.css"],
			"linter": {
				"rules": {
					"nursery": {
						"noDuplicateSelectors": "off",
						"useLayeredStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["**/__tests__/**", "**/__mocks__/**"],
			"javascript": {
				"globals": ["expect", "test", "vi"]
			}
		},
		{
			"includes": ["**"],
			"linter": {
				"rules": {
					"nursery": {
						"noReactNativeRawText": "off",
						"useConsistentFunctionStyle": {
							"level": "error",
							"options": { "style": "declaration" }
						},
						"useExplicitReturnType": "off",
						"useExplicitType": "off"
					},
					"performance": {
						"noJsxPropsBind": "off",
						"useSolidForComponent": "off"
					},
					"security": {
						"noSecrets": "off"
					},
					"style": {
						"noJsxLiterals": "off",
						"noTernary": "off",
						"useExportsLast": "off"
					},
					"suspicious": {
						"noReactSpecificProps": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.config.*"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					},
					"style": {
						"noDefaultExport": "off",
						"noProcessEnv": "off",
						"useNamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["**/__mocks__/**", "src/routes/api/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off",
						"useNamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"linter": {
				"rules": {
					"style": {
						"noMagicNumbers": "off"
					}
				}
			}
		}
	],
	"plugins": [
		{
			"includes": ["**"],
			"path": "./scripts/biome/architecture-boundaries.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./scripts/biome/prefer-once-mocks.grit"
		},
		{
			"includes": ["**"],
			"path": "./scripts/biome/no-inline-vitest-mock.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./scripts/biome/require-test-aaa.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./scripts/biome/no-side-effects-in-wait-for.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./scripts/biome/prefer-user-event.grit"
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
