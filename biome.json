{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"assist": {
		"actions": {
			"source": {
				"preset": "all",
				"useSortedPackageJson": "off"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"**",
			"!!**/{dist,coverage,public,.wrangler,test-results,playwright-report,.lighthouseci,.agents}",
			"!**/src/routeTree.gen.ts",
			"!**/src/types/cloudflare-env.d.ts"
		]
	},
	"linter": {
		"rules": {
			"a11y": {
				"preset": "all"
			},
			"complexity": {
				"preset": "all"
			},
			"nursery": {
				"preset": "all"
			},
			"performance": {
				"preset": "all",
				"useSolidForComponent": "off"
			},
			"security": {
				"noSecrets": "off",
				"preset": "all"
			},
			"style": {
				"noJsxLiterals": "off",
				"noTernary": "off",
				"preset": "all",
				"useExportsLast": "off"
			},
			"suspicious": {
				"noReactSpecificProps": "off",
				"preset": "all"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.config.*"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off",
						"noProcessEnv": "off",
						"useNamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["**/__mocks__/**", "src/routes/api/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off",
						"useNamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"linter": { "rules": { "style": { "noMagicNumbers": "off" } } }
		}
	],
	"plugins": [
		{
			"includes": ["**"],
			"path": "./.config/plugins/architecture-boundaries.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./.config/plugins/prefer-once-mocks.grit"
		},
		{
			"includes": ["**"],
			"path": "./.config/plugins/no-inline-vitest-mock.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./.config/plugins/require-test-aaa.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./.config/plugins/no-side-effects-in-wait-for.grit"
		},
		{
			"includes": ["**/__tests__/*.spec.{ts,tsx}"],
			"path": "./.config/plugins/prefer-user-event.grit"
		}
	],
	"root": true,
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"root": ".",
		"useIgnoreFile": true
	}
}
